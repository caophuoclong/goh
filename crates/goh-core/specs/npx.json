{
  "schemaVersion": 1,
  "name": "npx",
  "description": "Execute binaries from npm packages",
  "options": [
    {
      "name": "--package",
      "description": "Package to be installed",
      "takesValue": true,
      "args": [
        {
          "name": "package"
        }
      ]
    },
    {
      "name": "-p",
      "description": "Package to be installed",
      "takesValue": true,
      "args": [
        {
          "name": "package"
        }
      ]
    },
    {
      "name": "--cache",
      "description": "Location of the npm cache",
      "takesValue": true,
      "args": [
        {
          "name": "path",
          "template": "filepaths"
        }
      ]
    },
    {
      "name": "--always-spawn",
      "description": "Always spawn a child process to execute the command",
      "takesValue": false
    },
    {
      "name": "-y",
      "description": "Execute npx command without prompting for confirmation",
      "takesValue": false
    },
    {
      "name": "--no-install",
      "description": "Skip installation if a package is missing",
      "takesValue": false
    },
    {
      "name": "--userconfig",
      "description": "Path to user npmrc",
      "takesValue": true,
      "args": [
        {
          "name": "path",
          "template": "filepaths"
        }
      ]
    },
    {
      "name": "--call",
      "description": "Execute string as if inside `npm run-script`",
      "takesValue": true,
      "args": [
        {
          "name": "script"
        }
      ]
    },
    {
      "name": "-c",
      "description": "Execute string as if inside `npm run-script`",
      "takesValue": true,
      "args": [
        {
          "name": "script"
        }
      ]
    },
    {
      "name": "--shell",
      "description": "Shell to execute the command with, if any",
      "takesValue": true,
      "args": [
        {
          "name": "shell",
          "suggestions": [
            {
              "name": "bash"
            },
            {
              "name": "fish"
            },
            {
              "name": "zsh"
            }
          ]
        }
      ]
    },
    {
      "name": "-s",
      "description": "Shell to execute the command with, if any",
      "takesValue": true,
      "args": [
        {
          "name": "shell",
          "suggestions": [
            {
              "name": "bash"
            },
            {
              "name": "fish"
            },
            {
              "name": "zsh"
            }
          ]
        }
      ]
    },
    {
      "name": "--shell-auto-fallback",
      "description": "Generate shell code to use npx as the \"command not found\" fallback",
      "takesValue": true,
      "args": [
        {
          "name": "shell-fallback",
          "suggestions": [
            {
              "name": "bash"
            },
            {
              "name": "fish"
            },
            {
              "name": "zsh"
            }
          ]
        }
      ]
    },
    {
      "name": "--ignore-existing",
      "description": "Ignores existing binaries in $PATH, or in the localproject. This forces npx to do a temporary install and use the latest version",
      "takesValue": false
    },
    {
      "name": "--quiet",
      "description": "Suppress output from npx itself. Subcommands will not be affected",
      "takesValue": false
    },
    {
      "name": "-q",
      "description": "Suppress output from npx itself. Subcommands will not be affected",
      "takesValue": false
    },
    {
      "name": "--npm",
      "description": "Npm binary to use for internal operations",
      "takesValue": true,
      "args": [
        {
          "name": "path to binary",
          "template": "filepaths"
        }
      ]
    },
    {
      "name": "--node-arg",
      "description": "Extra node argument when calling a node binary",
      "takesValue": true,
      "args": [
        {
          "name": "argument"
        }
      ]
    },
    {
      "name": "-n",
      "description": "Extra node argument when calling a node binary",
      "takesValue": true,
      "args": [
        {
          "name": "argument"
        }
      ]
    },
    {
      "name": "--version",
      "description": "Show version number",
      "takesValue": false
    },
    {
      "name": "-v",
      "description": "Show version number",
      "takesValue": false
    },
    {
      "name": "--help",
      "description": "Show help",
      "takesValue": false
    },
    {
      "name": "-h",
      "description": "Show help",
      "takesValue": false
    }
  ],
  "args": [
    {
      "name": "command",
      "isVariadic": true,
      "isOptional": true,
