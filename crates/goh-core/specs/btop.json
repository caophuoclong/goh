{
  "schemaVersion": 1,
  "name": "btop",
  "description": "Beautifuler htop (interactive process viewer)",
  "options": [
    {
      "name": "--help",
      "description": "Shows help for btop",
      "takesValue": false
    },
    {
      "name": "-h",
      "description": "Shows help for btop",
      "takesValue": false
    },
    {
      "name": "--low-color",
      "description": "Disables truecolor, converts 24-bit colors to 256-color",
      "takesValue": false
    },
    {
      "name": "-lc",
      "description": "Disables truecolor, converts 24-bit colors to 256-color",
      "takesValue": false
    },
    {
      "name": "--tty_on",
      "description": "Forces ON tty mode, max 16 colors and tty friendly graph symbol",
      "takesValue": false
    },
    {
      "name": "-t",
      "description": "Forces ON tty mode, max 16 colors and tty friendly graph symbol",
      "takesValue": false
    },
    {
      "name": "--tty_off",
      "description": "Forces OFF tty mode",
      "takesValue": false
    },
    {
      "name": "--preset",
      "description": "Start with preset",
      "takesValue": true,
      "args": [
        {
          "name": "id",
          "suggestions": [
            {
              "name": "0"
            },
            {
              "name": "1"
            },
            {
              "name": "2"
            },
            {
              "name": "3"
            },
            {
              "name": "4"
            },
            {
              "name": "5"
            },
            {
              "name": "6"
            },
            {
              "name": "7"
            },
            {
              "name": "8"
            },
            {
              "name": "9"
            }
          ]
        }
      ]
    },
    {
      "name": "-p",
      "description": "Start with preset",
      "takesValue": true,
      "args": [
        {
          "name": "id",
          "suggestions": [
            {
              "name": "0"
            },
            {
              "name": "1"
            },
            {
              "name": "2"
            },
            {
              "name": "3"
            },
            {
              "name": "4"
            },
            {
              "name": "5"
            },
            {
              "name": "6"
            },
            {
              "name": "7"
            },
            {
              "name": "8"
            },
            {
              "name": "9"
            }
          ]
        }
      ]
    },
    {
      "name": "--utf-force",
      "description": "Force start even if no UTF-8 locale was detected",
      "takesValue": false
    },
    {
      "name": "--debug",
      "description": "Starts in DEBUG mode: shows microsecond timer for information collect and screen draw functions and sets loglevel to DEBUG",
      "takesValue": false
    },
    {
      "name": "--version",
      "description": "Shows the version of btop",
      "takesValue": false
    },
    {
      "name": "-v",
      "description": "Shows the version of btop",
      "takesValue": false
    }
  ]
}
