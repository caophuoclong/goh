{
  "schemaVersion": 1,
  "name": "fnm",
  "description": "Fast Node Manager",
  "options": [
    {
      "name": "--help",
      "description": "Prints help information",
      "takesValue": false
    },
    {
      "name": "-h",
      "description": "Prints help information",
      "takesValue": false
    },
    {
      "name": "--version",
      "description": "Prints version information",
      "takesValue": false
