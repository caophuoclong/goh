      "name": "-V",
      "description": "Prints version information",
      "takesValue": false
    },
    {
      "name": "--arch",
      "description": "Override the architecture of the installed Node binary. Defaults to arch of fnm binary",
      "takesValue": true,
      "args": [
        {
          "name": "arch",
          "suggestions": [
            {
              "name": "x86"
            },
            {
              "name": "x64"
            },
            {
              "name": "arm64"
            },
            {
              "name": "armv7l"
            },
            {
              "name": "ppc64le"
            },
            {
              "name": "ppc64"
            },
            {
              "name": "s390x"
            }
          ]
        }
      ]
    },
    {
      "name": "--fnm-dir",
      "description": "The root directory of fnm installations",
      "takesValue": true,
      "args": [
        {
          "name": "dir",
          "template": "folders"
        }
      ]
    },
    {
      "name": "--log-level",
