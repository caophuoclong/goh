{
  "schemaVersion": 1,
  "name": "env",
  "description": "Run a command with a changed environment",
  "options": [
    {
      "name": "-i",
      "description": "Start with an empty environment",
      "takesValue": false
    },
    {
      "name": "-u",
      "description": "Remove this variable",
      "takesValue": true,
      "args": [
        {
          "name": "name"
        }
      ]
    },
    {
      "name": "-C",
      "description": "Change to this directory first",
      "takesValue": true,
      "args": [
        {
          "name": "dir",
          "template": "folders"
        }
      ]
    }
  ],
  "args": [
    {
      "name": "command",
      "description": "The command to run",
      "isVariadic": true,
      "runsCommand": true
    }
  ]
}
