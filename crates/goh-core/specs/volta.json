                {
                  "name": "human"
                },
                {
                  "name": "plain"
                }
              ]
            }
          ]
        }
      ],
      "args": [
        {
          "name": "tool"
        }
      ]
    },
    {
      "name": "completions",
      "description": "Generates Volta completions",
      "options": [
        {
          "name": "-f",
          "description": "Write over an existing file, if any",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Write over an existing file, if any",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Enables verbose diagnostics",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Prevents unnecessary output",
          "takesValue": false
        },
        {
          "name": "-h",
          "description": "Prints help information",
          "takesValue": false
        },
        {
          "name": "--help",
          "description": "Prints help information",
          "takesValue": false
        },
        {
          "name": "-o",
          "description": "File to write generated completions to",
          "takesValue": true,
          "args": [
            {
              "name": "file"
            }
          ]
        },
        {
          "name": "--output",
          "description": "File to write generated completions to",
          "takesValue": true,
          "args": [
            {
              "name": "file"
            }
          ]
        }
