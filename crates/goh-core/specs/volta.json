          "takesValue": false
        },
        {
          "name": "-h",
          "description": "Prints help information",
          "takesValue": false
        },
        {
          "name": "--help",
          "description": "Prints help information",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "tool@version",
          "isVariadic": true
        }
      ]
    },
    {
