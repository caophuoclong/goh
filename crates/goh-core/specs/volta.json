        {
          "name": "-c",
          "description": "Show the currently-active tool(s)",
          "takesValue": false
        },
        {
          "name": "--current",
          "description": "Show the currently-active tool(s)",
          "takesValue": false
        },
        {
          "name": "-d",
          "description": "Show your default tool(s)",
          "takesValue": false
        },
        {
          "name": "--default",
          "description": "Show your default tool(s)",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Enables verbose diagnostics",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Prevents unnecessary output",
          "takesValue": false
        },
        {
          "name": "-h",
          "description": "Prints help information",
          "takesValue": false
        },
        {
          "name": "--help",
          "description": "Prints help information",
          "takesValue": false
        },
        {
          "name": "--format",
          "description": "Specify output format",
          "takesValue": true,
          "args": [
            {
              "name": "output format",
