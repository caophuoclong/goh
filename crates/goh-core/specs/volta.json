      "args": [
        {
          "name": "shell",
          "description": "Shell to generate completions for",
          "suggestions": [
            {
              "name": "zsh"
            },
            {
              "name": "bash"
            },
            {
              "name": "fish"
            },
            {
              "name": "powershell"
            },
            {
              "name": "elivsh"
            }
          ]
        }
      ]
    },
    {
      "name": "which",
      "description": "Locates the actual binary that will be called by Volta",
      "options": [
        {
          "name": "--verbose",
          "description": "Enables verbose diagnostics",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Prevents unnecessary output",
          "takesValue": false
        },
        {
          "name": "-h",
          "description": "Prints help information",
          "takesValue": false
        },
        {
          "name": "--help",
          "description": "Prints help information",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "binary",
          "isVariadic": true,
          "template": "filepaths"
        }
      ]
    },
    {
      "name": "setup",
      "description": "Enables Volta for the current user",
      "options": [
        {
          "name": "--verbose",
          "description": "Enables verbose diagnostics",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Prevents unnecessary output",
          "takesValue": false
        },
        {
          "name": "-h",
          "description": "Prints help information",
          "takesValue": false
        },
        {
          "name": "--help",
          "description": "Prints help information",
          "takesValue": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a command with custom Node, npm, and/or Yarn versions",
      "options": [
        {
          "name": "--bundle",
          "description": "Forces npm to be the version bundled with Node",
          "takesValue": false
        },
        {
          "name": "--no-yarn",
          "description": "Disables Yarn",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Enables verbose diagnostics",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Prevents unnecessary output",
          "takesValue": false
        },
        {
          "name": "--node",
          "description": "Set the custom Node version",
          "takesValue": true,
          "args": [
            {
              "name": "version"
            }
          ]
        },
        {
          "name": "--npm",
          "description": "Set the custom npm version",
          "takesValue": true,
          "args": [
            {
              "name": "version"
            }
          ]
        },
        {
          "name": "--yarn",
          "description": "Set the custom Yarn version",
          "takesValue": true,
          "args": [
            {
              "name": "version"
            }
          ]
        },
        {
          "name": "--env",
          "description": "Set an environment variable (can be used multiple times)",
          "takesValue": true,
          "args": [
            {
              "name": "NAME=value"
            }
          ],
          "isRepeatable": true
        }
      ],
      "args": [
        {
          "name": "command"
        }
      ]
    },
    {
      "name": "help",
      "description": "Prints this message or the help of the given subcommand(s)",
      "args": [
        {
          "name": "subcommand"
        }
      ]
    }
