{
  "schemaVersion": 1,
  "name": "ln",
  "description": "Create (default hard) symbolic links to files",
  "options": [
    {
      "name": "-s",
      "description": "Create a symbolic link",
      "takesValue": true,
      "args": [
        {
          "name": "source_file",
          "template": "filepaths"
        },
        {
          "name": "link_name or link_dirname",
          "isOptional": true
        }
      ]
    },
    {
      "name": "-v",
      "description": "Verbose",
      "takesValue": false
    },
    {
      "name": "-F",
      "description": "If link name already exists replace it",
      "takesValue": true,
      "args": [
        {
          "name": "source_file",
          "template": "filepaths"
        },
        {
          "name": "link_name or link_dirname",
          "isOptional": true
        }
      ]
    },
    {
      "name": "-h",
      "description": "Don't follow symbolic links",
      "takesValue": false
    },
    {
      "name": "-f",
      "description": "If link name already exists unlink the old one before creating the new one",
      "takesValue": true,
      "args": [
        {
          "name": "source_file",
          "template": "filepaths"
        },
        {
          "name": "link_name or link_dirname",
          "isOptional": true
        }
      ]
    },
    {
      "name": "-i",
      "description": "Prompt if proposed link already exists",
      "takesValue": true,
      "args": [
        {
          "name": "source_file",
          "template": "filepaths"
        },
        {
          "name": "link_name or link_dirname",
          "isOptional": true
        }
      ]
    },
    {
      "name": "-n",
      "description": "Same as -h don't follow symbolic links",
      "takesValue": false
    }
  ],
  "args": [
    {
      "name": "source_file",
      "template": "filepaths"
    },
    {
      "name": "link_name or link_dirname",
      "isOptional": true
    }
  ]
}
