{
  "schemaVersion": 1,
  "name": "git",
  "description": "Distributed version control",
  "options": [
    {
      "name": "--help",
      "description": "Show help",
      "takesValue": false
    },
    {
      "name": "--version",
      "description": "Print the version",
      "takesValue": false
    }
  ],
  "subcommands": [
    {
      "name": "add",
      "description": "Add file contents to the index",
      "args": [
        {
          "name": "pathspec",
          "template": "filepaths",
          "isVariadic": true
        }
      ]
    },
    {
      "name": "branch",
      "description": "List, create or delete branches"
    },
    {
      "name": "check-ignore",
      "description": "Debug ignore behavior"
    },
    {
      "name": "checkout",
      "description": "Switch branches or restore paths",
      "options": [
        {
          "name": "-b",
          "description": "Create and switch to a new branch",
          "takesValue": true,
          "args": [
            {
              "name": "b"
            }
          ]
        },
        {
          "name": "--detach",
          "description": "Detach HEAD at the commit",
          "takesValue": false
        },
        {
          "name": "--track",
          "description": "Set up tracking",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "branch",
          "suggestions": [
            {
              "name": "main"
            },
            {
              "name": "feature/accessibility-contract"
            },
            {
              "name": "fix/inline-fallback-quoting"
            },
            {
              "name": "release/0.1"
            }
          ]
        }
      ]
    },
    {
      "name": "cherry-pick",
      "description": "Apply changes from a commit"
    },
    {
      "name": "clean",
      "description": "Remove untracked files from the working tree"
    },
    {
      "name": "clone",
      "description": "Clone a repository into a new directory"
    },
    {
      "name": "commit",
      "description": "Record changes to the repository",
      "options": [
        {
          "name": "--all",
          "description": "Stage tracked changes first",
          "takesValue": false
        },
        {
          "name": "--amend",
          "description": "Replace the previous commit",
          "takesValue": false
        },
        {
          "name": "--message",
          "description": "Use the given commit message",
          "takesValue": true,
          "args": [
            {
              "name": "message"
            }
          ]
        },
        {
          "name": "--no-verify",
          "description": "Skip pre-commit hooks",
          "takesValue": false
        }
      ]
    },
    {
      "name": "diff",
      "description": "Show changes between commits and files"
    },
    {
      "name": "fetch",
      "description": "Download objects and refs"
    },
    {
      "name": "log",
      "description": "Show commit logs"
    },
    {
      "name": "merge",
      "description": "Join two or more histories together",
      "args": [
        {
          "name": "branch",
          "suggestions": [
            {
              "name": "main"
            },
            {
              "name": "feature/accessibility-contract"
            },
            {
              "name": "fix/inline-fallback-quoting"
            },
            {
              "name": "release/0.1"
            }
          ]
        }
      ]
    },
    {
      "name": "pull",
      "description": "Fetch from and integrate with a remote"
    },
    {
      "name": "push",
      "description": "Update remote refs and objects",
      "options": [
        {
          "name": "--dry-run",
          "description": "Show what would be pushed",
          "takesValue": false
        },
        {
          "name": "--force-with-lease",
          "description": "Safer force push",
          "takesValue": false
        },
        {
          "name": "--set-upstream",
          "description": "Track the remote branch",
          "takesValue": false
        },
        {
          "name": "--tags",
          "description": "Push all tags",
          "takesValue": false
        }
      ]
    },
    {
      "name": "rebase",
      "description": "Reapply commits on top of another base"
    },
    {
      "name": "restore",
      "description": "Restore working tree files"
    },
    {
      "name": "stash",
      "description": "Stash changes in a dirty working directory"
    },
    {
      "name": "status",
      "description": "Show the working tree status"
    },
    {
      "name": "switch",
      "description": "Switch branches",
      "args": [
        {
          "name": "branch",
          "suggestions": [
            {
              "name": "main"
            },
            {
              "name": "feature/accessibility-contract"
            },
            {
              "name": "fix/inline-fallback-quoting"
            },
            {
              "name": "release/0.1"
            }
          ]
        }
      ]
    },
    {
      "name": "tag",
      "description": "Create, list or delete tags"
    }
  ]
}
