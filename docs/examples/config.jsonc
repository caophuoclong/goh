// goh settings; comments are allowed. `goh config show` checks this file.
// Open shells pick a change up after `exec $SHELL`.
{
  "display": {
    // "auto", "overlay" (always the popup) or "inline" (always in the terminal).
    "mode": "auto",
    // The menu in the terminal: "box" or "flat" (plain rows, easier for a screen reader).
    "inlineStyle": "box",
    // "unicode", or "nerd" (logos and file icons; needs a Nerd Font Mono).
    "icons": "unicode",
    // Rows shown at once (1-50).
    "maxSuggestions": 8,
    // Open the menu as you type; false = only on Tab.
    "live": true,
    // Ghost text with the likely next command at an empty prompt (needs privacy.recordCommands).
    "predict": false,
    // Enter takes the picked suggestion and runs the line; false = Enter only inserts it.
    "enterRuns": true
  },

  "popup": {
    // "" = the terminal's own font where goh can read it.
    "font": "",
    // In points (8-32).
    "fontSize": 13,
    // macOS: one Accessibility permission for Goh itself, not one per terminal (experimental).
    "ownPermission": false,
    // Draw a zsh host's menus here over `ssh`; false = plain ssh.
    "overSsh": true
  },

  "theme": {
    // "auto", "light", "dark", or "custom" with "foreground", "background" (and "accent") as "#rrggbb".
    "mode": "auto"
  },

  "privacy": {
    // Rank the suggestions you pick first next time.
    "learnChoices": true,
    // Keep the lines you run in a local file, for history, predict and option values. `goh forget` deletes it.
    "recordCommands": false
  },

  "completion": {
    // Read `<program> --help` once for a program goh has no suggestions for.
    "autoSpecs": false
  },

  "updates": {
    // Once a day, ask GitHub for the latest version and say so when a newer one exists.
    "check": false
  }
}
