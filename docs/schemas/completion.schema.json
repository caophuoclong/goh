{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/terminal-companion/completion.schema.json",
  "title": "Terminal Companion Completion Specification v1",
  "description": "Declarative, non-executable command completion schema. The $id is a placeholder; change before publishing.",
  "$ref": "#/$defs/command",
  "$defs": {
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "insertValue": { "type": "string", "maxLength": 2048 },
        "kind": { "type": "string", "enum": ["argument", "subcommand", "option", "file", "directory"] }
      }
    },
    "arg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "isOptional": { "type": "boolean", "default": false },
        "isVariadic": { "type": "boolean", "default": false },
        "isCommand": { "type": "boolean", "default": false },
        "template": { "type": "string", "enum": ["filepaths", "folders"] },
        "extensions": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9]+(\\.[A-Za-z0-9]+)*$" }, "maxItems": 32 },
        "provider": { "type": "string", "enum": ["docker-containers", "docker-all-containers", "docker-images", "frecent-dirs", "ssh-hosts", "ssh-remotes", "kube-contexts", "aws-profiles", "git-branches", "git-remotes", "git-tags", "git-stashes", "git-changed-files", "git-staged-files", "package-scripts", "make-targets", "just-recipes", "taskfile-tasks", "compose-services", "cargo-bins", "cargo-examples", "cargo-features", "workspace-packages"] },
        "providers": { "type": "array", "items": { "type": "string", "enum": ["docker-containers", "docker-all-containers", "docker-images", "frecent-dirs", "ssh-hosts", "ssh-remotes", "kube-contexts", "aws-profiles", "git-branches", "git-remotes", "git-tags", "git-stashes", "git-changed-files", "git-staged-files", "package-scripts", "make-targets", "just-recipes", "taskfile-tasks", "compose-services", "cargo-bins", "cargo-examples", "cargo-features", "workspace-packages"] }, "maxItems": 8 },
        "suggestions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/suggestion" } }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^-" },
        "description": { "type": "string", "maxLength": 1024 },
        "takesValue": { "type": "boolean", "default": false },
        "isRepeatable": { "type": "boolean", "default": false },
        "args": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/arg" } }
      },
      "allOf": [
        { "if": { "properties": { "takesValue": { "const": false } }, "required": ["takesValue"] }, "then": { "not": { "required": ["args"] } } }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "subcommands": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/command" } },
        "options": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/option" } },
        "args": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/arg" } },
        "suggestions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/suggestion" } }
      }
    }
  },
  "allOf": [
    { "properties": { "schemaVersion": { "const": 1 } }, "required": ["schemaVersion"] }
  ]
}
