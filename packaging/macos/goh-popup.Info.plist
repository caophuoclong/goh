<?xml version="1.0" encoding="UTF-8"?>
<!-- Info.plist of goh-popup.app, filled in by scripts/package.sh. macOS keeps the Accessibility permission of an app
     under its bundle identifier, so the identifier must never change. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>io.github.caophuoclong.goh.popup</string>
  <key>CFBundleName</key>
  <string>goh-popup</string>
  <key>CFBundleExecutable</key>
  <string>goh-popup</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
