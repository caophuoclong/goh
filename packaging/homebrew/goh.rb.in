# Generated by scripts/render-formula.sh from packaging/homebrew/goh.rb.in; edits here are overwritten at the next release.
class Goh < Formula
  desc "Spec-driven terminal autocomplete: IDE-style suggestions in your existing shell"
  homepage "https://github.com/caophuoclong/goh"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/caophuoclong/goh/releases/download/v@VERSION@/goh-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/caophuoclong/goh/releases/download/v@VERSION@/goh-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/caophuoclong/goh/releases/download/v@VERSION@/goh-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_AARCH64_LINUX@"
    end
    on_intel do
      url "https://github.com/caophuoclong/goh/releases/download/v@VERSION@/goh-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_X86_64_LINUX@"
    end
  end

  def install
    bin.install Dir["bin/*"]
  end

  def caveats
    <<~EOS
      Homebrew does not edit your shell files. Run this once, then open a new terminal:

        goh setup

      It adds one marked block to ~/.zshrc, ~/.bashrc or fish's config.fish (zsh, bash and fish);
      `goh setup --uninstall` removes it. By hand: eval "$(goh init zsh)" in ~/.zshrc, after compinit.

      The overlay popup (macOS) needs Accessibility access for your terminal; `goh doctor` says what is missing.
      After `brew upgrade goh`, run `goh reload` and `exec $SHELL`.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/goh version")
  end
end
